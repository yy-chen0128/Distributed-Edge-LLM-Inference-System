# 统一换行符：shell 脚本必须是 LF，否则在 WSL/Linux 里会报 `$'\r': command not found`
*.sh   text eol=lf
*.bash text eol=lf

# 源码与文档按仓库内容为准，不做 CRLF 转换
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文件不做任何转换
*.safetensors binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
*.ico binary
