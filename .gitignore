# 论文分析参考（第三方代码，独立仓库，不作为运行时依赖入库）
#   vllm / LMCache 是上游源码快照：我们只"读"它们来评估复用边界，没有 hack/修改。
#   即使将来要改，也另开独立仓库，不放进本项目。
#   上游地址与版本见 docs/deploy/project-structure-and-build.md
/vllm/
/LMCache/
/spotserve/
/moe-infinity/
/preble/
/helix/

# 引擎选型调研用的第三方源码快照（只读，用于核对能力；见
# docs/research/inference-engine-selection.md）。
#   ollama        MIT，Go 服务端源码（核对"有没有跨机机制"）
#   lmstudio-python / lms  MIT，LM Studio 的客户端 SDK 与 CLI（服务端闭源）
/ollama/
/ollama-src/
/lmstudio-python/
/lmstudio-js/
/lms/

# 文档/报告目录
/mark/

# 参考资料（PDF/图片/zip 不入库）
*.pdf
*.zip
*.png
*.jpg

# 临时文件
clone_status.txt
*.clone.log
helix.tar.gz

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# IDE
.vscode/
.idea/

# 临时/日志
*.log
*.tmp
.DS_Store

# ===== 本机/大文件：绝不入库 =====
# 模型权重与 HF 缓存（几百 MB ~ 十几 GB；各机自行用 scripts/hf_mirror_download.py 下载）
/.models/
/.hf/
*.safetensors
*.part

# 凭据：agent 专用 SSH 私钥、known_hosts —— 一旦入库等于泄漏
/.ssh/
*_ed25519
id_rsa*
known_hosts

# 本地虚拟环境与包缓存（在 WSL 原生盘即可，不入库）
/.venvs/
/.venv-gpu/
/.pipcache/
/pipcache/

# 运行时产物与桥接临时目录
/.wslbridge/
/.logs/

